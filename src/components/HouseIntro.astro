---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

import { site } from '../config/site';


/* =========================================================
   HOUSE PHOTOS

   Change ONLY these filenames so they match the exact
   photos inside:

   src/assets/photos/
   ========================================================= */

const HOUSE_PHOTOS = {
  entrance: 'DSC09314.jpg',

  pool: 'DSC09260.jpg',

  entertainment:
    'DSC09239.jpg',

  gym: 'DSC09302.jpg',

  sunset:
    'DSC09236.jpg',
};


/* =========================================================
   FIND PHOTOS FROM ASSETS
   ========================================================= */

const photoModules = import.meta.glob(
  '../assets/photos/*.{jpg,jpeg,png,webp,avif}',
  {
    eager: true,
  }
);


function getPhoto(
  fileName: string
): ImageMetadata | null {

  const foundPhoto =
    Object.entries(
      photoModules
    ).find(
      ([path]) =>
        path.endsWith(
          `/${fileName}`
        )
    );


  if (!foundPhoto) {
    return null;
  }


  const photoModule =
    foundPhoto[1] as {
      default:
        ImageMetadata;
    };


  return photoModule.default;
}


const entrancePhoto =
  getPhoto(
    HOUSE_PHOTOS.entrance
  );


const poolPhoto =
  getPhoto(
    HOUSE_PHOTOS.pool
  );


const entertainmentPhoto =
  getPhoto(
    HOUSE_PHOTOS.entertainment
  );


const gymPhoto =
  getPhoto(
    HOUSE_PHOTOS.gym
  );


const sunsetPhoto =
  getPhoto(
    HOUSE_PHOTOS.sunset
  );


/* =========================================================
   HOUSE DETAILS
   ========================================================= */

const address =
  '18A Dordrecht street, Milnerton';


const highlights = [
  {
    number: '4',
    label: 'Bedrooms',
    detail:
      '2 queen rooms + 2 single-bed rooms',
  },

  {
    number: '4.5',
    label: 'Bathrooms',
    detail:
      'Plenty of space for larger groups',
  },

  {
    number: '12',
    label: 'Guests',
    detail:
      'Comfortable group accommodation',
  },

  {
    number: '4–5',
    label: 'Cars',
    detail:
      'Garage and secure parking',
  },
];


const distances = [
  {
    place:
      'Lagoon Beach',
    time:
      '5 min',
  },

  {
    place:
      'Blouberg Beach',
    time:
      '10 min',
  },

  {
    place:
      'Canal Walk',
    time:
      '10 min',
  },

  {
    place:
      'Cape Town CBD',
    time:
      '10 min',
  },
];
---

