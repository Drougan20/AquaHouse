---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

import { site } from '../config/site';


/* =========================================================
   HERO PHOTO

   Put the EXACT filename of the photo you want here.

   The photo must exist inside:

   src/assets/photos/
   ========================================================= */

const HERO_PHOTO =
  'DSC09176.jpg';


/* =========================================================
   HERO PHOTO POSITION

   If the photo needs moving inside the frame later,
   we only change this value.

   Examples:

   'center center'
   'center 35%'
   'center 60%'
   'left center'
   ========================================================= */

const HERO_PHOTO_POSITION =
  'center center';


/* =========================================================
   HERO PHOTO ALT TEXT
   ========================================================= */

const HERO_PHOTO_ALT =
  'Aqua House in Cape Town';


/* =========================================================
   FIND PHOTO INSIDE ASSETS
   ========================================================= */

const photoModules =
  import.meta.glob(
    '../assets/photos/*.{jpg,jpeg,png,webp,avif}',
    {
      eager: true,
    }
  );


function getPhoto(
  fileName: string
): ImageMetadata | null {

  const foundPhoto =
    Object.entries(
      photoModules
    ).find(
      ([path]) =>
        path.endsWith(
          `/${fileName}`
        )
    );


  if (!foundPhoto) {
    return null;
  }


  const photoModule =
    foundPhoto[1] as {
      default:
        ImageMetadata;
    };


  return photoModule.default;
}


const heroImage =
  getPhoto(
    HERO_PHOTO
  );
---

<section
  id="top"
  class="hero"
  aria-labelledby="hero-title"
>
  <div class="hero-decoration hero-decoration-one"></div>

  <div class="hero-decoration hero-decoration-two"></div>


  <div class="container hero-grid">

    <!-- ===================================================
         HERO COPY
         =================================================== -->

    <div class="hero-copy">

      <p class="eyebrow">
        An entire house to yourself

        {
          site.area
            ? ` · ${site.area}`
            : ''
        }
      </p>


      <h1 id="hero-title">
        {site.name}
      </h1>


      <p class="intro">
        A relaxed and spacious
        Cape Town stay made for
        families, friends and
        unforgettable time together.
      </p>


      <div class="hero-details">

        <span>
          4 bedrooms
        </span>

        <span
          class="detail-dot"
          aria-hidden="true"
        >
          ·
        </span>

        <span>
          4.5 bathrooms
        </span>

        <span
          class="detail-dot"
          aria-hidden="true"
        >
          ·
        </span>

        <span>
          Sleeps 12
        </span>

      </div>

      <address class="hero-address">
  18A Dordrecht Street, Milnerton, Cape Town
</address>


      <div class="hero-actions">

        <a
          class="primary-link"
          href="#availability"
        >
          Enquire about your stay
        </a>


        <a
          class="secondary-link"
          href="#gallery"
        >
          Explore the photos

          <span aria-hidden="true">
            ↗
          </span>
        </a>

      </div>

    </div>


    <!-- ===================================================
         HERO IMAGE
         =================================================== -->

    <div class="hero-art">

      <div
        class="hero-frame"
        aria-hidden="true"
      ></div>


      <div class="photo-arch" style={`--hero-photo-position: ${HERO_PHOTO_POSITION};`}>

        {
          heroImage ? (
            <Image
              src={heroImage}
              alt={HERO_PHOTO_ALT}
              widths={[
                600,
                800,
                1000,
                1200,
              ]}
              sizes="
                (max-width: 760px) 92vw,
                (max-width: 1100px) 45vw,
                520px
              "
              format="webp"
              loading="eager"
              fetchpriority="high"
            />
          ) : (
            <div
              class="photo-placeholder"
              aria-hidden="true"
            >
              <span>
                Add your Aqua House
                hero photo
              </span>
            </div>
          )
        }

      </div>


      <!-- SMALL FLOATING DETAIL -->

      <div class="hero-note">

        <span class="hero-note-line"></span>

        <div>
          <small>
            Cape Town
          </small>

          <strong>
            Relax. Stay. Explore.
          </strong>
        </div>

      </div>

    </div>

  </div>
</section>


<style>

  /* =======================================================
     HERO
     ======================================================= */

  .hero {
    position: relative;

    overflow: hidden;

    padding:
      clamp(
        4.5rem,
        8vw,
        7.5rem
      )
      0;

    background:
      linear-gradient(
        135deg,
        #eff7f4 0%,
        #e7f2ef 48%,
        #f4f8f5 100%
      );
  }


  /* =======================================================
     SOFT BACKGROUND DETAILS
     ======================================================= */

  .hero-decoration {
    position: absolute;

    border-radius: 999px;

    pointer-events: none;
  }


  .hero-decoration-one {
    width: 420px;
    height: 420px;

    top: -230px;
    right: 17%;

    background:
      rgba(
        132,
        178,
        167,
        0.12
      );
  }


  .hero-decoration-two {
    width: 280px;
    height: 280px;

    left: -150px;
    bottom: -170px;

    border:
      1px solid
      rgba(
        62,
        116,
        107,
        0.12
      );
  }


  /* =======================================================
     GRID
     ======================================================= */

  .hero-grid {
    position: relative;

    z-index: 2;

    display: grid;

    grid-template-columns:
      minmax(
        0,
        1fr
      )
      minmax(
        420px,
        0.9fr
      );

    align-items: center;

    gap:
      clamp(
        4rem,
        8vw,
        9rem
      );
  }


  /* =======================================================
     COPY
     ======================================================= */

  .hero-copy {
    max-width: 40rem;
  }


  .eyebrow {
    margin: 0;

    color:
      #34766d;

    font-size:
      0.76rem;

    font-weight:
      800;

    letter-spacing:
      0.19em;

    line-height:
      1.5;

    text-transform:
      uppercase;
  }


  h1 {
    margin:
      1.25rem
      0
      1.6rem;

    color:
      #173f3b;

    font-size:
      clamp(
        4rem,
        7.6vw,
        7rem
      );

    font-weight:
      500;

    line-height:
      0.92;

    letter-spacing:
      -0.065em;
  }


  .intro {
    max-width:
      35rem;

    margin: 0;

    color:
      #536e69;

    font-size:
      clamp(
        1.05rem,
        1.55vw,
        1.28rem
      );

    line-height:
      1.75;
  }


  /* =======================================================
     QUICK DETAILS
     ======================================================= */

  .hero-details {
    margin-top:
      1.65rem;

    display:
      flex;

    flex-wrap:
      wrap;

    align-items:
      center;

    gap:
      0.65rem;

    color:
      #52746d;

    font-size:
      0.9rem;

    font-weight:
      700;
  }


  .detail-dot {
    color:
      #95b7ae;
  }

  .hero-address {
  margin: 1.1rem 0 0;
  color: var(--color-sea-dark);
  font-size: 0.95rem;
  font-style: normal;
  font-weight: 600;
  line-height: 1.5;
}


  /* =======================================================
     ACTIONS
     ======================================================= */

  .hero-actions {
    margin-top:
      2.6rem;

    display:
      flex;

    flex-wrap:
      wrap;

    align-items:
      center;

    gap:
      1.25rem
      2rem;
  }


  .primary-link {
    min-height:
      3.35rem;

    display:
      inline-flex;

    align-items:
      center;

    justify-content:
      center;

    padding:
      0.85rem
      1.6rem;

    border-radius:
      999px;

    background:
      #34766d;

    color:
      white;

    font-size:
      0.95rem;

    font-weight:
      700;

    text-decoration:
      none;

    box-shadow:
      0
      10px
      30px
      rgba(
        31,
        83,
        76,
        0.12
      );

    transition:
      background-color
        180ms ease,
      transform
        180ms ease,
      box-shadow
        180ms ease;
  }


  .primary-link:hover {
    background:
      #235f57;

    transform:
      translateY(
        -2px
      );

    box-shadow:
      0
      14px
      34px
      rgba(
        31,
        83,
        76,
        0.18
      );
  }


  .secondary-link {
    color:
      #34766d;

    font-size:
      0.95rem;

    font-weight:
      700;

    text-decoration:
      none;

    border-bottom:
      1px solid
      rgba(
        52,
        118,
        109,
        0.4
      );

    padding-bottom:
      0.2rem;
  }


  .secondary-link:hover {
    border-color:
      #34766d;
  }


  .secondary-link span {
    margin-left:
      0.25rem;
  }


  /* =======================================================
     HERO ART
     ======================================================= */

  .hero-art {
    position: relative;

    width: 100%;

    max-width:
      540px;

    justify-self:
      end;

    padding:
      1.3rem
      1.3rem
      2.2rem
      0;
  }


  /* =======================================================
     OFFSET OUTLINE
     ======================================================= */

  .hero-frame {
    position: absolute;

    inset:
      3.7rem
      0
      1.3rem
      3.5rem;

    border:
      1px solid
      rgba(
        80,
        137,
        126,
        0.55
      );

    border-radius:
      48%
      48%
      1.7rem
      1.7rem
      /
      27%
      27%
      1.7rem
      1.7rem;
  }


  /* =======================================================
     PHOTO
     ======================================================= */

  .photo-arch {
    position: relative;

    z-index: 2;

    width: 100%;

    aspect-ratio:
      4 / 5;

    overflow: hidden;

    border-radius:
      48%
      48%
      1.7rem
      1.7rem
      /
      27%
      27%
      1.7rem
      1.7rem;

    background:
      #cfe1dc;

    box-shadow:
      0
      28px
      70px
      rgba(
        34,
        84,
        77,
        0.1
      );
  }


  .photo-arch :global(img) {
    position: absolute;
    inset: 0;
    display: block;

    width: 100%;
    height: 100%;

    object-fit: cover;

    object-position:
      var(
        --hero-photo-position,
        center center
      );
  }




  /* =======================================================
     PLACEHOLDER
     ======================================================= */

  .photo-placeholder {
    width: 100%;
    height: 100%;

    display:
      flex;

    align-items:
      center;

    justify-content:
      center;

    padding:
      2rem;

    background:
      linear-gradient(
        145deg,
        #cfe2dc,
        #a9cbc2
      );

    color:
      #235f57;

    text-align:
      center;

    font-weight:
      700;
  }


  /* =======================================================
     SMALL IMAGE NOTE
     ======================================================= */

  .hero-note {
    position: absolute;

    z-index: 4;

    right:
      -1rem;

    bottom:
      0;

    min-width:
      210px;

    display:
      flex;

    align-items:
      center;

    gap:
      0.9rem;

    padding:
      1rem
      1.25rem;

    background:
      rgba(
        245,
        250,
        248,
        0.96
      );

    border:
      1px solid
      rgba(
        96,
        147,
        137,
        0.25
      );

    box-shadow:
      0
      16px
      40px
      rgba(
        34,
        84,
        77,
        0.1
      );

    backdrop-filter:
      blur(
        10px
      );
  }


  .hero-note-line {
    width:
      2rem;

    height:
      1px;

    flex-shrink:
      0;

    background:
      #77a99e;
  }


  .hero-note small {
    display:
      block;

    color:
      #78968f;

    font-size:
      0.67rem;

    font-weight:
      800;

    letter-spacing:
      0.12em;

    text-transform:
      uppercase;
  }


  .hero-note strong {
    display:
      block;

    margin-top:
      0.2rem;

    color:
      #235f57;

    font-family:
      Georgia,
      serif;

    font-size:
      0.95rem;

    font-weight:
      400;
  }


  /* =======================================================
     TABLET
     ======================================================= */

  @media (
    max-width:
      1000px
  ) {

    .hero-grid {
      grid-template-columns:
        minmax(
          0,
          1fr
        )
        minmax(
          340px,
          0.85fr
        );

      gap:
        3rem;
    }


    .hero-art {
      max-width:
        450px;
    }


    h1 {
      font-size:
        clamp(
          3.7rem,
          7vw,
          5.5rem
        );
    }

  }


  /* =======================================================
     MOBILE
     ======================================================= */

  @media (
    max-width:
      760px
  ) {

    .hero {
      padding:
        3.75rem
        0
        4.5rem;
    }


    .hero-grid {
      grid-template-columns:
        1fr;

      gap:
        3.5rem;
    }


    .hero-copy {
      max-width:
        none;
    }


    h1 {
      font-size:
        clamp(
          3.7rem,
          17vw,
          5.5rem
        );
    }


    .intro {
      max-width:
        32rem;
    }


    .hero-art {
      width:
        min(
          92%,
          31rem
        );

      max-width:
        none;

      margin-inline:
        auto;

      justify-self:
        center;
    }


    .hero-note {
      right:
        -1rem;
    }

  }


  @media (
    max-width:
      500px
  ) {

    .hero {
      padding-top:
        3rem;
    }


    .hero-details {
      gap:
        0.45rem;
    }


    .hero-actions {
      align-items:
        flex-start;

      flex-direction:
        column;

      gap:
        1.4rem;
    }


    .primary-link {
      width:
        100%;
    }


    .hero-art {
      width:
        100%;

      padding-right:
        0.6rem;
    }


    .hero-frame {
      inset:
        2.8rem
        0
        1.5rem
        2rem;
    }


    .hero-note {
      right:
        0;

      bottom:
        0;

      min-width:
        auto;

      width:
        78%;
    }

  }


  /* =======================================================
     ACCESSIBILITY
     ======================================================= */

  @media (
    prefers-reduced-motion:
      reduce
  ) {

    .primary-link {
      transition:
        none;
    }

  }

</style>