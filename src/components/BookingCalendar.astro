    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
  }

  .booking-intro {
    padding-top: 2rem;
  }

  .eyebrow {
    margin: 0 0 1rem;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.19em;
  }

  .booking-intro h2 {
    margin: 0 0 1.5rem;
    font-size: clamp(3.2rem, 6vw, 5.5rem);
    line-height: 0.97;
    letter-spacing: -0.055em;
  }

  .booking-intro > p:not(.eyebrow) {
    max-width: 30rem;
    line-height: 1.7;
  }

  .booking-note {
    opacity: 0.75;
  }

  .booking-card {
    min-width: 0;
    padding: clamp(1.25rem, 3vw, 2.25rem);
    border: 1px solid #dce5dd;
    border-radius: 1.5rem;
    background: #fff;
    box-shadow: 0 24px 65px rgb(23 63 56 / 8%);
  }

  .card-title {
    margin: 0;
    font-size: 1.75rem;
    line-height: 1.1;
  }

  .card-intro {
    margin: 0.65rem 0 1.4rem;
    color: #52716b;
    line-height: 1.5;
  }

  .booking-picker {
    position: relative;
  }

  .booking-bar {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 0.6rem;
  }

  .date-control,
  .night-count,
  .view-calendar {
    min-width: 0;
    min-height: 4.5rem;
    padding: 0.7rem 0.85rem;
    border: 1px solid #d9e6dd;
    border-radius: 0.7rem;
    background: #fbfcf9;
    color: #193d39;
    font: inherit;
  }

  .date-control {
    display: grid;
    grid-template-columns: 1fr auto;
    align-content: center;
    gap: 0.25rem;
    text-align: left;
    cursor: pointer;
  }

  .date-control > span:first-child,
  .night-count > span {
    grid-column: 1 / -1;
    color: #637e73;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  .date-control strong {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 0.94rem;
  }

  .calendar-icon {
    width: 1.1rem;
    height: 1.1rem;
    fill: none;
    stroke: #39725e;
    stroke-width: 1.8;
    stroke-linecap: round;
  }

  .date-control:hover,
  .date-control.is-active {
    border-color: #368c71;
    background: #eef6f0;
  }

  .night-count {
    display: grid;
    align-content: center;
    gap: 0.3rem;
  }

  .night-count strong {
    font-size: 1rem;
  }

  .view-calendar {
    color: #20564d;
    font-weight: 800;
    cursor: pointer;
  }

  .view-calendar:hover {
    background: #eef6f0;
  }

  .booking-status {
    min-height: 1.4rem;
    margin: 0.8rem 0;
    color: #52716b;
    font-size: 0.84rem;
  }

  .calendar-popover {
    position: absolute;
    z-index: 20;
    top: calc(100% + 0.75rem);
    left: 50%;
    transform: translateX(-50%);
    width: min(720px, calc(100vw - 2rem));
    max-height: min(72vh, 640px);
    overflow-y: auto;
    padding: clamp(1rem, 2.5vw, 1.5rem);
    border: 1px solid #dce5dd;
    border-radius: 1rem;
    background: #fff;
    box-shadow: 0 22px 55px rgb(23 63 56 / 18%);
  }

  .calendar-popover[hidden] {
    display: none;
  }

  .calendar-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .calendar-top h3 {
    margin: 0;
    font-size: 1.2rem;
  }

  .calendar-top .eyebrow {
    margin-bottom: 0.35rem;
  }

  .month-buttons {
    display: flex;
    gap: 0.5rem;
  }

  .month-buttons button {
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid #dce5dd;
    border-radius: 50%;
    background: #fff;
    color: inherit;
    cursor: pointer;
  }

  .month-buttons button:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .calendar-instruction {
    margin: 0.9rem 0 0;
    color: #52716b;
    font-size: 0.82rem;
    line-height: 1.5;
  }

  .booking :global(.booking-month-pair) {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.85rem;
    margin: 1.1rem 0;
  }

  .booking :global(.booking-month-pair.has-one-month) {
    grid-template-columns: minmax(0, 1fr);
  }

  .booking :global(.booking-month-panel) {
    min-width: 0;
    padding: 0.6rem;
    border: 1px solid #e0e9e2;
    border-radius: 0.75rem;
    background: #fbfcf9;
  }

  .booking :global(.booking-month-panel[hidden]) {
    display: none;
  }

  .booking :global(.booking-month-title) {
    margin: 0 0 0.85rem;
    color: #20564d;
    font-size: 0.95rem;
    font-weight: 800;
  }

  .booking-days {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 0.2rem;
    width: 100%;
  }

  .booking-days :global(.booking-weekday) {
    padding: 0.25rem 0;
    color: #6b817b;
    font-size: 0.68rem;
    font-weight: 800;
    text-align: center;
  }

  .booking-days :global(.booking-empty) {
    aspect-ratio: 1;
  }

  .booking-days :global(.booking-day) {
    min-width: 0;
    padding: 0;
    aspect-ratio: 1;
    border: 0;
    border-radius: 0.6rem;
    background: transparent;
    color: #193d39;
    font: inherit;
    font-size: 0.86rem;
    cursor: pointer;
  }

  .booking-days :global(.booking-day:hover:not(:disabled)) {
    background: #dcebe3;
  }

  .booking-days :global(.booking-day.is-between) {
    background: #e3eee8;
  }

  .booking-days :global(.booking-day.is-blocked) {
    background: #f1f0ed;
    color: #889790;
    text-decoration: line-through;
  }

  .booking-days :global(.booking-day.is-checkout-only) {
    background: #e8f3ec;
    color: #20564d;
    text-decoration: none;
    outline: 2px dashed #74a08c;
    outline-offset: -3px;
  }

  .booking-days :global(.booking-day.is-past) {
    background: #e9eeeb;
    color: #75857d;
    opacity: 0.5;
    text-decoration: line-through;
  }

  .booking-days :global(.booking-day.is-selected) {
    background: var(--color-sea);
    color: #fff;
    opacity: 1;
    text-decoration: none;
    outline: 0;
  }

  .booking-days :global(.booking-day:disabled) {
    cursor: default;
  }

  .calendar-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    color: #627972;
    font-size: 0.78rem;
  }

  .calendar-legend span {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .calendar-legend i {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
  }

  .available {
    background: #368c71;
  }

  .unavailable {
    background: #b7bfba;
  }

  .past {
    background: #e9eeeb;
    border: 1px solid #aebcb3;
  }

  .price-summary {
    display: grid;
    gap: 0.35rem;
    padding-top: 1.25rem;
    border-top: 1px solid #e2eae4;
  }

  .price-summary small {
    color: #698078;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  .price-summary strong {
    font-size: 1.55rem;
  }

  .booking-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: 1.1rem;
  }

  .booking-actions :global(button),
