  }

  .inquire-button {
    border: 1px solid #20564d;
    background: #20564d;
    color: #fff;
  }

  .inquire-button {
  border: 1px solid var(--color-sea);
  background: var(--color-sea);
  color: #fff;
}

.inquire-button:hover:not(:disabled) {
  border-color: var(--color-sea-dark);
  background: var(--color-sea-dark);
}

  .inquiry-form {
