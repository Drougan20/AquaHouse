<section id="availability" class="booking" aria-labelledby="booking-title">
  <div class="booking-layout">
    <div class="booking-intro">
      <p class="eyebrow">PLAN YOUR STAY</p>
      <h2 id="booking-title">Find your dates.</h2>
      <p>
        Explore availability for the whole house, see your estimated stay
        total, and send us an enquiry.
      </p>
      <p class="booking-note">
        Dates and prices are confirmed when we reply to your enquiry.
      </p>
    </div>

    <div class="booking-card">
      <p class="eyebrow">YOUR WHOLE-HOUSE STAY</p>
      <h3 class="card-title">Choose your stay.</h3>
      <p class="card-intro">
        Tap a date to open the calendar. Choose check-in first, then check-out.
      </p>

      <div id="booking-picker" class="booking-picker">
        <div class="booking-bar">
          <button
            id="booking-check-in-button"
            class="date-control"
            type="button"
            aria-controls="booking-calendar-popover"
            aria-expanded="false"
          >
            <span>CHECK-IN</span>
            <strong id="booking-check-in">Choose date</strong>
            <svg class="calendar-icon" aria-hidden="true" viewBox="0 0 24 24">
              <rect x="3" y="5" width="18" height="16" rx="2"></rect>
              <path d="M7 3v4M17 3v4M3 10h18"></path>
            </svg>
          </button>

          <button
            id="booking-check-out-button"
            class="date-control"
            type="button"
            aria-controls="booking-calendar-popover"
            aria-expanded="false"
          >
            <span>CHECK-OUT</span>
            <strong id="booking-check-out">Choose date</strong>
            <svg class="calendar-icon" aria-hidden="true" viewBox="0 0 24 24">
              <rect x="3" y="5" width="18" height="16" rx="2"></rect>
              <path d="M7 3v4M17 3v4M3 10h18"></path>
            </svg>
          </button>

          <div class="night-count" aria-live="polite">
            <span>TOTAL NIGHTS</span>
            <strong id="booking-nights">Select dates</strong>
          </div>

          <button
            id="booking-view-calendar"
            class="view-calendar"
            type="button"
            aria-controls="booking-calendar-popover"
            aria-expanded="false"
          >
            View calendar
          </button>
        </div>

        <div
          id="booking-calendar-popover"
          class="calendar-popover"
          role="region"
          aria-label="Availability calendar"
          hidden
        >
          <div class="calendar-top">
            <div>
              <p class="eyebrow">SELECT YOUR DATES</p>
              <h3 id="booking-month">Calendar</h3>
            </div>

            <div class="month-buttons">
              <button
                id="booking-previous"
                type="button"
                aria-label="Previous month"
              >
                ←
              </button>
              <button
                id="booking-next"
                type="button"
                aria-label="Next month"
              >
                →
              </button>
            </div>
          </div>

          <p class="calendar-instruction">
            Choose check-in, then check-out. Booked dates are unavailable
            for overnight stays.
          </p>

          <div
            id="booking-days"
            class="booking-days"
            aria-label="Choose your dates"
          ></div>

          <div class="calendar-legend">
            <span><i class="available"></i> Available</span>
            <span><i class="unavailable"></i> Booked</span>
            <span><i class="past"></i> Past date</span>
          </div>
        </div>
      </div>

      <p id="booking-status" class="booking-status" role="status">
        Loading availability…
      </p>

      <div class="price-summary">
        <small>ESTIMATED TOTAL</small>
        <strong id="booking-total">Choose your dates</strong>
      </div>

      <p id="booking-quote-status" class="booking-status" role="status"></p>

      <div class="booking-actions">
        <button id="booking-refresh" class="refresh-button" type="button">
          Refresh availability
        </button>

        <button
          id="booking-inquire"
          class="inquire-button"
          type="button"
          disabled
        >
          Inquire about these dates
        </button>
      </div>

      <form id="booking-form" class="inquiry-form" hidden>
        <h3>Send an enquiry</h3>
        <p>Share your plans and how we can reach you.</p>

        <label for="booking-name">Your name</label>
        <input id="booking-name" name="name" type="text" maxlength="100" />

        <div class="contact-fields">
          <div>
            <label for="booking-email">Email address</label>
            <input id="booking-email" name="email" type="email" />
          </div>

          <div>
            <label for="booking-phone">Phone number</label>
            <input id="booking-phone" name="phone" type="tel" />
          </div>
        </div>

        <p class="field-hint">
          Enter an email address, a phone number, or both.
        </p>

        <label for="booking-message">Message</label>
        <textarea
          id="booking-message"
          name="message"
          rows="4"
          maxlength="3000"
          required
          placeholder="Tell us about your stay…"
        ></textarea>

        <div class="trap" aria-hidden="true">
          <label for="booking-website">Website</label>
          <input
            id="booking-website"
            name="website"
            type="text"
            tabindex="-1"
            autocomplete="off"
          />
        </div>

        <button id="booking-send" class="inquire-button" type="submit">
          Send enquiry
        </button>
        <p id="booking-form-status" role="status"></p>
      </form>
    </div>
  </div>
</section>

<style>
  .booking {
  padding: clamp(5rem, 9vw, 8rem) 1.25rem;
  background: var(--color-paper);
  color: var(--color-ink);
}

  .booking-layout {
    width: min(100%, 1150px);
