---
import { site } from '../config/site';
---

<header class="site-header">
  <div class="container header-inner">
    <a
      class="brand"
      href="/#top"
      aria-label={`${site.name} home`}
    >
      {site.name}
    </a>

    <nav aria-label="Main navigation">
      <a class="nav-link" href="/#house">The house</a>
      <a class="nav-link" href="/#gallery">Gallery</a>
      <a class="nav-link" href="/#contact">Contact</a>

      <a class="nav-book-now" href="/#availability">
        Book now
      </a>
    </nav>

    <a class="enquire-link" href="/#availability">
      Enquire about dates
      <span aria-hidden="true">↗</span>
    </a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--color-background);
    border-bottom: 1px solid var(--color-line);
  }

  .header-inner {
    min-height: 76px;
    display: flex;
    align-items: center;
    gap: 32px;
  }

  .brand {
    flex-shrink: 0;
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: 24px;
    letter-spacing: -0.04em;
    white-space: nowrap;
  }

  nav {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .nav-link {
    min-height: 48px;
    display: inline-flex;
    align-items: center;
    color: var(--color-ink);
    font-size: 14px;
    white-space: nowrap;
  }

  .nav-link:hover {
    color: var(--color-sea);
    text-decoration: underline;
    text-underline-offset: 5px;
  }

  .nav-book-now,
  .enquire-link {
    min-height: 48px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    font-size: 14px;
    font-weight: 700;
    white-space: nowrap;
    transition:
      background-color 160ms ease,
      color 160ms ease,
      transform 160ms ease;
  }

  .nav-book-now {
    padding: 0 21px;
    background: var(--color-sea);
    color: white;
  }

  .nav-book-now:hover {
    background: var(--color-sea-dark);
    transform: translateY(-1px);
  }

  .enquire-link {
    gap: 12px;
    padding: 0 19px;
    border: 1px solid var(--color-sea);
    color: var(--color-sea);
  }

  .enquire-link:hover {
    background: var(--color-soft-teal);
    transform: translateY(-1px);
  }

  @media (max-width: 900px) {
    .header-inner {
      gap: 22px;
    }

    nav {
      gap: 20px;
    }

    .enquire-link {
      display: none;
    }
  }

  @media (max-width: 760px) {
    .header-inner {
      min-height: 68px;
    }

    .nav-link {
      display: none;
    }
  }

  @media (max-width: 600px) {
    .brand {
      font-size: 21px;
    }

    .nav-book-now {
      min-height: 44px;
      padding: 0 18px;
      font-size: 13px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-book-now,
    .enquire-link {
      transition: none;
    }
  }
</style>